          "level": "warning",
          "message": {
            "text": "Static openURL uses raw URL ignoring preparedForOpeningInBrowser in background path  [CVSS 4.3: CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:L/I:N/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Modules/RSWeb/Sources/RSWeb/MacWebBrowser.swift"
                },
